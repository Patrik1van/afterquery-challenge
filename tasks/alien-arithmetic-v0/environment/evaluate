#!/usr/bin/env python3
"""Query the lab.

Usage:
  evaluate "2 ⊕ 3"     evaluate an expression (costs 1 query if valid)
  evaluate --budget    show remaining budget (free)
"""

import json
import os
import sys
import urllib.error
import urllib.request

LAB_URL = os.environ.get("LAB_URL", "http://lab:8000")


def call(method, path, payload=None):
    data = json.dumps(payload).encode("utf-8") if payload is not None else None
    req = urllib.request.Request(
        LAB_URL + path, data=data, method=method,
        headers={"Content-Type": "application/json"},
    )
    try:
        with urllib.request.urlopen(req, timeout=10) as r:
            return r.status, json.loads(r.read())
    except urllib.error.HTTPError as e:
        return e.code, json.loads(e.read())


def main():
    args = sys.argv[1:]
    if not args or args[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0
    if args[0] == "--budget":
        _, body = call("GET", "/budget")
        print(f"queries used: {body['queries_used']}/{body['budget']}, left: {body['queries_left']}")
        return 0
    expr = " ".join(args)
    status, body = call("POST", "/evaluate", {"expr": expr})
    if status == 200:
        print(f"{body['expr']} = {body['result']}    (queries left: {body['queries_left']})")
        return 0
    print(f"error: {body.get('error')}", file=sys.stderr)
    if "queries_left" in body:
        print(f"(queries left: {body['queries_left']})", file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main())
