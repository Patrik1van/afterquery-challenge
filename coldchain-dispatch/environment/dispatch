#!/usr/bin/env python3
"""dispatch — control the cold-chain delivery fleet.

  dispatch state                       show clock, vehicles and visible orders (JSON)
  dispatch route <vehicle> <stop> ...  replace a vehicle's remaining stops (order ids or DEPOT)
  dispatch route <vehicle>             clear a vehicle's route (it stops where it is)
  dispatch wait <minutes>              advance the clock 1-120 min; vehicles drive, new orders may appear
  dispatch finish                      end the shift (remaining time still elapses)
"""
import json, os, sys, urllib.request, urllib.error

BASE = os.environ.get("SIM_URL", "http://sim:8000")

def call(method, path, payload=None):
    data = json.dumps(payload).encode() if payload is not None else None
    req = urllib.request.Request(BASE + path, data=data, method=method,
                                 headers={"Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            return json.load(r)
    except urllib.error.HTTPError as e:
        return json.load(e)

def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__); return 0
    cmd, rest = argv[0], argv[1:]
    if cmd == "state":
        out = call("GET", "/state")
    elif cmd == "route" and rest:
        out = call("POST", "/route", {"vehicle": rest[0], "stops": rest[1:]})
    elif cmd == "wait" and len(rest) == 1:
        try:
            out = call("POST", "/wait", {"minutes": float(rest[0])})
        except ValueError:
            out = {"error": "minutes must be a number"}
    elif cmd == "finish":
        out = call("POST", "/finish", {})
    else:
        print(__doc__); return 2
    print(json.dumps(out, indent=1))
    return 1 if "error" in out else 0

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
